#!/usr/bin/env sh
# Runs quality gates before every commit: whitespace/conflict-marker check,
# lint, TypeScript typecheck, and the full test suite.

set -eu

# Reject trailing whitespace and leftover conflict markers in the staged diff
git diff --cached --check

echo "Running lint..."
pnpm lint

echo "Running typecheck..."
pnpm typecheck

echo "Running tests..."
pnpm test