    "terminal",
    "ansi"
  ],
  "license": "MIT",
  "dependencies": {
    "@typescript-calendar-lib/core": "workspace:^",
    "@typescript-calendar-lib/tui": "workspace:^"
  },
  "author": "nazozokc",
  "homepage": "https://github.com/nazozokc/typescript-calendar-lib#readme",
  "bugs": {
    "url": "https://github.com/nazozokc/typescript-calendar-lib/issues"
  },
  "engines": {
    "node": ">=22"
  },
