{
  "name": "@typescript-calendar-lib/react",
  "version": "0.6.0",
  "description": "React 19 calendar components with CSS themes and color schemes",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nazozokc/typescript-calendar-lib",
    "directory": "packages/react"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./calendar.css": "./dist/calendar.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && cp ../web/dist/calendar.css dist/calendar.css",
    "prepack": "pnpm build"
  },
  "keywords": [
    "calendar",
    "react",
    "component",
    "ui"
  ],
  "license": "MIT",
  "dependencies": {
    "@typescript-calendar-lib/core": "workspace:^",
    "@typescript-calendar-lib/tui": "workspace:^",
    "@typescript-calendar-lib/web": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "author": "nazozokc",
  "homepage": "https://github.com/nazozokc/typescript-calendar-lib#readme",
  "bugs": {
    "url": "https://github.com/nazozokc/typescript-calendar-lib/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
