{
  "name": "@typescript-calendar-lib/svelte",
  "version": "1.0.0",
  "description": "Svelte 5 components and reactive state for typescript-calendar-lib",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nazozokc/typescript-calendar-lib",
    "directory": "packages/svelte"
  },
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./calendar.css": "./dist/calendar.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src && cp ../web/dist/calendar.css dist/calendar.css",
    "prepack": "pnpm build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "keywords": [
    "calendar",
    "svelte",
    "component",
    "ui"
  ],
  "license": "MIT",
  "peerDependencies": {
    "svelte": "^5"
  },
  "dependencies": {
    "@typescript-calendar-lib/core": "workspace:^",
    "@typescript-calendar-lib/tui": "workspace:^",
    "@typescript-calendar-lib/web": "workspace:^"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5",
    "jsdom": "^30",
    "svelte-check": "^4",
    "typescript": "^5.9.0",
    "vitest": "^5"
  }
}
