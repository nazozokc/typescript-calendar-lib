{
  "name": "typescript-calendar-lib",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "pnpm -r run build",
    "audit:dependencies": "pnpm audit --audit-level high",
    "check:dependencies": "node scripts/check-runtime-dependencies.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @typescript-calendar-lib/svelte run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts && cp docs/dist/index.html docs/dist/404.html",
    "docs:preview": "vite preview --config docs/vite.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dompurify": "^3.2.4",
    "fast-check": "^4.10.2",
    "highlight.js": "^11.12.0",
    "svelte": "^5.57.0",
    "tsdown": "^0.23.0",
    "typescript": "^7",
    "vite": "^8",
    "vite-plugin-markdown": "^2.2.0",
    "vitest": "^5"
  }
}
